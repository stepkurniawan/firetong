FIRETONG_OPENAI_BASE_URL=https://api.openai.com/v1
FIRETONG_OPENAI_API_KEY=
FIRETONG_TRANSCRIPTION_MODEL=gpt-realtime-whisper
FIRETONG_REALTIME_INPUT_LANGUAGE=id
FIRETONG_REALTIME_TRANSLATION_MODEL=gpt-realtime-translate
FIRETONG_REALTIME_TRANSLATION_LANGUAGE=en
FIRETONG_REALTIME_TRANSCRIPTION_DELAY=low
FIRETONG_TRANSCRIPT_SAVE_DIR=saved-sessions
FIRETONG_FEEDBACK_EMAIL_TO=stepkurniawan.learn@gmail.com
FIRETONG_FEEDBACK_EMAIL_FROM=firetong.repo@gmail.com
FIRETONG_FEEDBACK_SMTP_HOST=smtp.gmail.com
FIRETONG_FEEDBACK_SMTP_PORT=587
FIRETONG_FEEDBACK_SMTP_USERNAME=firetong.repo@gmail.com
FIRETONG_FEEDBACK_SMTP_PASSWORD=
FIRETONG_FEEDBACK_SMTP_STARTTLS=true
FIRETONG_FEEDBACK_SMTP_SSL=false

# Docker Compose host folder for saved transcript sessions
FIRETONG_TRANSCRIPT_HOST_DIR=./saved-sessions

# NAS deployment with compose.nas.yaml
FIRETONG_IMAGE=stepkurniawan/firetong:latest
