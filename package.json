{
  "name": "firetong-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:api": "uv run uvicorn backend.firetong.main:app --host 127.0.0.1 --port 8000 --reload --reload-dir backend",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && tsc -p tsconfig.service-worker.json",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "node --test --experimental-strip-types frontend/src/**/*.test.ts"
  },
  "devDependencies": {
    "@tsconfig/svelte": "^5.0.4",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@types/node": "^24.0.0",
    "svelte": "^5.19.0",
    "svelte-check": "^4.1.4",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
